---
// src/components/chrome/Footer.astro
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <span class="footer-claim">"读得慢，写得久 —— 把每一段思考当作一处地形。"</span>
    <span class="footer-meta">
      <span class="footer-brand-en">BigButters</span>
      <span class="footer-sep">·</span>
      <span class="footer-brand-cn">大大黄油</span>
      <span class="footer-since">since MMXXVI · {year}</span>
    </span>
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 64px;
    width: 100%;
  }
  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 32px;
    max-width: 1200px;
    margin: 0 auto;
    font-family: 'EB Garamond', serif;
    font-size: 12px;
    color: var(--ink-faint);
  }
  .footer-claim { font-style: italic; }
  .footer-meta { display: inline-flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .footer-sep { opacity: 0.4; }
  .footer-brand-cn { color: var(--accent); }
  .footer-since { color: var(--ink-faint); opacity: 0.7; margin-left: 4px; }

  @media (max-width: 640px) {
    .site-footer-inner { flex-direction: column; gap: 8px; padding: 16px 20px; }
  }
</style>
