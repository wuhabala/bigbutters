---
// src/components/chrome/CoverCard.astro
// 专题/研究封面缩略 · 用于首页 + 列表页
// coverImage 接 ImageMetadata（Astro image() schema 输出）时，
// 自动用 Astro <Image> 优化管线（WebP + 多倍图 + lazy + width/height）
import { Image } from 'astro:assets';
import { getTheme, tokensToCss, type ThemeId } from '@themes';
import EscherCover from '@components/themes/escher/EscherCover.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  href: string;
  title: string;
  theme: ThemeId;
  meta?: string;
  /** 优先接 ImageMetadata（Zod image() 处理后），其次 string（原始 URL） */
  coverImage?: ImageMetadata | string;
  aspectRatio?: string;
}
const { href, title, theme, meta, coverImage, aspectRatio = '3 / 4' } = Astro.props;
const pack = getTheme(theme);
const cardTokens = tokensToCss(pack.tokens);
const hasImage = !!coverImage;
const isMetadata = !!coverImage && typeof coverImage !== 'string' && 'src' in coverImage;
---
<a class="cover-card" href={href} data-theme={theme}
   style={`background: ${pack.tokens.bg}; color: ${pack.tokens.ink}; aspect-ratio: ${aspectRatio}; ${cardTokens}`}>
  {hasImage && isMetadata ? (
    <Image
      src={coverImage as ImageMetadata}
      alt={title}
      widths={[320, 640, 960]}
      sizes="(max-width: 640px) 100vw, 320px"
      loading="lazy"
      decoding="async"
      format="webp"
    />
  ) : hasImage ? (
    <img src={coverImage as string} alt={title} loading="lazy" decoding="async" />
  ) : theme === 'escher' ? (
    <EscherCover {title} {meta} />
  ) : (
    <div class="cover-fallback">
      <span class="cover-title" style={`color: ${pack.tokens.ink};`}>{title}</span>
      {meta && <span class="cover-meta" style={`color: ${pack.tokens.accent};`}>{meta}</span>}
    </div>
  )}
</a>
<style>
  .cover-card {
    display: block;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    border-bottom: none;
  }
  .cover-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0,0,0,0.12);
  }
  .cover-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cover-fallback {
    position: absolute; inset: 0;
    padding: 12px 14px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .cover-title {
    font-family: 'Noto Serif SC', serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.1;
  }
  .cover-meta {
    font-family: 'EB Garamond', serif;
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .cover-card[data-theme='escher'] {
    border: 1px solid #c9bca9;
    box-shadow: 8px 8px 0 rgba(201, 188, 169, 0.22);
  }
  .cover-card[data-theme='escher']:hover {
    transform: translate(-3px, -3px);
    box-shadow: 14px 14px 0 rgba(201, 188, 169, 0.3);
  }

  /* Basquiat 主题下封面卡 hover 更夸张 */
  :global(body.theme-basquiat) .cover-card {
    border: 2.5px solid var(--ink);
    box-shadow: 4px 4px 0 0 var(--ink);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  :global(body.theme-basquiat) .cover-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--ink);
  }
</style>
