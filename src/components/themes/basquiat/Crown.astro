---
// src/components/themes/basquiat/Crown.astro
// Basquiat 招牌三角王冠
export interface Props {
  size?: number;
  inline?: boolean;
}
const { size = 32, inline = false } = Astro.props;
---
<svg
  class:list={['basquiat-crown', { inline }]}
  width={size}
  height={size * 0.7}
  viewBox="0 0 64 44"
  fill="none"
  aria-hidden="true"
>
  {/* 三个三角尖 + 底座 */}
  <path
    d="M 4 38 L 14 8 L 22 30 L 32 4 L 42 30 L 50 8 L 60 38 L 4 38 Z"
    fill="#f8d12b"
    stroke="#0a0a0a"
    stroke-width="2.5"
    stroke-linejoin="round"
    stroke-linecap="round"
  />
  {/* 底座下的双线 */}
  <line x1="6" y1="40" x2="58" y2="40" stroke="#0a0a0a" stroke-width="2"/>
</svg>
<style>
  .basquiat-crown {
    display: block;
    margin: 0 auto;
  }
  .basquiat-crown.inline {
    display: inline-block;
    vertical-align: -0.2em;
    margin: 0 4px;
  }
</style>
