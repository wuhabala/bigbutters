---
// src/components/themes/heckel/HeckelMark.astro
// Erich Heckel 木刻图记——优先用 src/assets/themes/heckel/mark-*.png（MJ 真图），
// 没有图片或显式 useSvg 时回退到内置 SVG（简化棱角版）。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import markMountain from '../../../assets/themes/heckel/mark-mountain.png';
import markSun from '../../../assets/themes/heckel/mark-sun.png';
import markBird from '../../../assets/themes/heckel/mark-bird.png';
import markTree from '../../../assets/themes/heckel/mark-tree.png';
import heroFacePortrait from '../../../assets/themes/heckel/hero-face-portrait.png';

export interface Props {
  variant: 'mountain' | 'sun' | 'face' | 'tree' | 'bird';
  size?: number;
  /** 强制使用内置 SVG（即便有 PNG）—— 用于极小尺寸或纯色覆盖场景 */
  useSvg?: boolean;
  ink?: string;
  accent?: string;
  bg?: string;
  carved?: boolean;
}
const {
  variant,
  size = 80,
  useSvg = false,
  ink = '#0f0a06',
  accent = '#d92410',
  bg = 'transparent',
  carved = false,
} = Astro.props;

const imageMap: Record<Props['variant'], ImageMetadata> = {
  mountain: markMountain,
  sun: markSun,
  bird: markBird,
  tree: markTree,
  face: heroFacePortrait,
};
const img = useSvg ? null : imageMap[variant];
---
{img ? (
  <Image
    src={img}
    alt=""
    width={size * 2}
    densities={[1, 2]}
    format="webp"
    loading="lazy"
    decoding="async"
    class="hk-mark hk-mark-img"
    style={`width:${size}px;height:auto;`}
  />
) : (
  <svg class="hk-mark" width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
    {bg !== 'transparent' && <rect width="100" height="100" fill={bg}/>}

    {variant === 'mountain' && (
      <>
        <polygon points="0,80 30,30 55,70 75,40 100,80" fill={accent}/>
        <polygon points="0,90 25,55 50,85 70,60 100,90 100,100 0,100" fill={ink}/>
        <circle cx="78" cy="22" r="9" fill={accent}/>
        {carved && (
          <g stroke={ink} stroke-width="1.5" opacity="0.7">
            <line x1="10" y1="92" x2="18" y2="92"/>
            <line x1="30" y1="94" x2="42" y2="94"/>
            <line x1="55" y1="92" x2="65" y2="92"/>
          </g>
        )}
      </>
    )}

    {variant === 'sun' && (
      <>
        <circle cx="50" cy="50" r="28" fill={accent}/>
        {Array.from({ length: 8 }).map((_, i) => {
          const angle = (i * Math.PI * 2) / 8;
          const x1 = 50 + Math.cos(angle) * 32;
          const y1 = 50 + Math.sin(angle) * 32;
          const x2 = 50 + Math.cos(angle) * 46;
          const y2 = 50 + Math.sin(angle) * 46;
          return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={ink} stroke-width="5" stroke-linecap="square"/>;
        })}
        <circle cx="50" cy="50" r="28" fill="none" stroke={ink} stroke-width="3.5"/>
      </>
    )}

    {variant === 'face' && (
      <>
        <polygon points="50,8 80,28 78,72 60,92 40,92 22,72 20,28" fill={bg === 'transparent' ? '#f4ead0' : bg} stroke={ink} stroke-width="4.5" stroke-linejoin="miter"/>
        <polygon points="62,40 72,42 70,62 60,60" fill={accent}/>
        <line x1="32" y1="42" x2="44" y2="46" stroke={ink} stroke-width="3.5"/>
        <line x1="56" y1="46" x2="68" y2="42" stroke={ink} stroke-width="3.5"/>
        <line x1="42" y1="74" x2="58" y2="72" stroke={ink} stroke-width="3"/>
      </>
    )}

    {variant === 'tree' && (
      <>
        <polygon points="44,98 56,98 54,55 60,55 50,18 40,55 46,55" fill={ink}/>
        <polygon points="20,55 50,30 80,55 70,62 50,46 30,62" fill={accent}/>
        {carved && (
          <g stroke={ink} stroke-width="1.2" opacity="0.55">
            <line x1="28" y1="58" x2="34" y2="60"/>
            <line x1="62" y1="60" x2="70" y2="58"/>
          </g>
        )}
      </>
    )}

    {variant === 'bird' && (
      <>
        <polygon points="50,52 30,38 14,46 28,52 12,60 30,60 50,72" fill={ink}/>
        <polygon points="50,52 70,38 86,46 72,52 88,60 70,60 50,72" fill={ink}/>
        <polygon points="50,52 56,40 62,52 56,68" fill={accent}/>
      </>
    )}
  </svg>
)}

<style>
  .hk-mark { display: block; }
  .hk-mark-img { object-fit: contain; height: auto; }
</style>
