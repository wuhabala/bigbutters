---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImpossibleSteps from './ImpossibleSteps.astro';

export interface Props {
  title: string;
  subtitle?: string;
  heroImage?: ImageMetadata;
  eyebrow?: string;
  routeLabel?: string;
}
const { title, subtitle, heroImage, eyebrow = '专题', routeLabel = '12 ROUTES' } = Astro.props;
---
<header class="esch-hero">
  <div class="geometry" aria-hidden="true">
    <span class="geo-block"></span>
    <span class="geo-path"></span>
    <span class="geo-node"></span>
  </div>
  <div class="hero-copy">
    <div class="eyebrow"><ImpossibleSteps size={62} /><span>{eyebrow} · {routeLabel}</span></div>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
    <div class="route"><span>A</span><i></i><span>B</span><i></i><span>A</span></div>
  </div>
  <figure class="hero-object">
    {heroImage ? (
      <Image src={heroImage} alt={title} widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 430px" loading="eager" format="webp" />
    ) : (
      <svg viewBox="0 0 470 470" aria-hidden="true">
        <path class="left" d="M62 335 L215 417 L215 184 L62 103 Z" />
        <path class="right" d="M215 417 L410 316 L410 83 L215 184 Z" />
        <path class="top" d="M62 103 L257 2 L410 83 L215 184 Z" />
        <path class="arch" d="M100 322 V248 Q100 222 124 235 L155 251 V351 Z M275 367 V289 Q275 267 297 255 L327 239 V359 Z" />
        <path class="walk" d="M93 129 L195 183 L298 130 L196 76 Z" />
        <path class="stair" d="M111 123 L130 133 L149 123 L130 113 Z M130 113 L149 123 L168 113 L149 103 Z M149 103 L168 113 L187 103 L168 93 Z M168 93 L187 103 L206 93 L187 83 Z M187 83 L206 93 L225 83 L206 73 Z" />
        <path class="turn" d="M298 130 V208 L280 218 V140 M280 218 L261 208 V197 L280 207" />
        <path class="window" d="M338 170 L376 150 V190 L338 210 Z M338 235 L376 215 V255 L338 275 Z" />
        <circle class="person" cx="100" cy="115" r="6" />
      </svg>
    )}
  </figure>
</header>
<style>
  .esch-hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(290px, 430px);
    gap: 44px;
    align-items: center;
    margin-bottom: 56px;
  }
  .geometry { position: absolute; inset: -28px -20px -24px -26px; pointer-events: none; z-index: -1; }
  .geo-block {
    position: absolute;
    left: 2px;
    top: 112px;
    width: clamp(118px, 16vw, 190px);
    height: 118px;
    border: 1px solid rgba(68, 141, 139, 0.3);
    border-right: none;
  }
  .geo-path {
    position: absolute;
    left: clamp(95px, 14vw, 166px);
    right: 405px;
    top: 172px;
    height: 72px;
    border-top: 1px solid rgba(68, 141, 139, 0.33);
    border-right: 1px solid rgba(68, 141, 139, 0.33);
    transform: skewY(29deg);
    transform-origin: top left;
  }
  .geo-node {
    position: absolute;
    right: 404px;
    top: 251px;
    width: 9px;
    height: 9px;
    background: var(--accent);
  }
  .hero-copy { min-width: 0; position: relative; z-index: 1; }
  .eyebrow { display: flex; align-items: center; gap: 14px; color: var(--ochre); margin-bottom: 22px; }
  .eyebrow span { font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.34em; }
  h1 {
    font-family: var(--font-sans);
    font-size: clamp(38px, 5vw, 52px);
    font-weight: 300;
    letter-spacing: 0.035em;
    line-height: 1.12;
    margin-bottom: 16px;
  }
  p { font-family: var(--font-sans); font-size: 17px; letter-spacing: 0.05em; color: var(--ink-soft); }
  .route { display: flex; align-items: center; gap: 12px; margin-top: 32px; color: var(--accent); font-size: 11px; letter-spacing: 0.24em; }
  .route i { display: block; width: 42px; height: 1px; background: var(--rule); position: relative; }
  .route i::after { content: ''; position: absolute; right: 0; top: -3px; width: 7px; height: 7px; border-top: 1px solid var(--ochre); border-right: 1px solid var(--ochre); transform: rotate(45deg); }
  .hero-object { position: relative; margin: 0; background: var(--bg-soft); border: 1px solid var(--rule); padding: 18px; box-shadow: 18px 18px 0 rgba(201,188,169,0.27); }
  .hero-object::before {
    content: '';
    position: absolute;
    top: -1px;
    right: 28px;
    width: 68px;
    height: 7px;
    background: linear-gradient(90deg, var(--ochre) 0 62%, var(--accent) 62%);
  }
  .hero-object::after {
    content: '';
    position: absolute;
    left: -12px;
    bottom: 34px;
    width: 12px;
    height: 82px;
    background: var(--ochre);
    opacity: 0.8;
  }
  .hero-object :global(img), .hero-object svg { display: block; width: 100%; height: auto; }
  .left { fill: #d7c6ad; stroke: var(--ink); stroke-width: 1.4; }
  .right { fill: #e7dac6; stroke: var(--ink); stroke-width: 1.4; }
  .top, .walk { fill: #fdf9f1; stroke: var(--ink); stroke-width: 1.4; }
  .arch { fill: var(--ochre); opacity: 0.45; stroke: var(--ink); stroke-width: 1.3; }
  .stair { fill: #fffdf8; stroke: var(--ink); stroke-width: 1.2; }
  .turn { fill: var(--bg-deep); stroke: var(--ink); stroke-width: 1.3; }
  .window { fill: var(--ochre); opacity: 0.54; }
  .person { fill: var(--accent); }
  @media (max-width: 820px) {
    .esch-hero { grid-template-columns: 1fr; gap: 28px; }
    .hero-object { max-width: 480px; }
    .geometry { display: none; }
  }
</style>
