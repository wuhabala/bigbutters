---
// src/layouts/ResearchLayout.astro
import BaseLayout from './BaseLayout.astro';
import Header from '@components/chrome/Header.astro';
import Footer from '@components/chrome/Footer.astro';
import BasquiatHero from '@components/themes/basquiat/BasquiatHero.astro';
import BasquiatBackground from '@components/themes/basquiat/BasquiatBackground.astro';
import type { ThemeId } from '@themes';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
  theme: ThemeId;
  description?: string;
  ogImage?: string;
  /** 研究专题的 hero 大图 · Basquiat 主题下显示在 hero 右侧 */
  heroImage?: ImageMetadata;
}
const { title, subtitle, theme, description, ogImage, heroImage } = Astro.props;
const isBasquiat = theme === 'basquiat';
---
<BaseLayout {title} {description} {theme} {ogImage}>
  {isBasquiat && <BasquiatBackground />}
  <Header activeNav="research" />
  <main class="research-main" class:list={{ 'bsq-main': isBasquiat }}>
    {isBasquiat ? (
      <BasquiatHero
        eyebrow="研究"
        title={title}
        subtitle={subtitle}
        stamp="RESEARCH"
        heroImage={heroImage}
      />
    ) : (
      <header class="research-hero">
        <p class="research-eyebrow">研究</p>
        <h1 class="research-title">{title}</h1>
        {subtitle && <p class="research-subtitle">{subtitle}</p>}
      </header>
    )}
    <slot />
  </main>
  <Footer />
</BaseLayout>
<style>
  .research-main { max-width: 1100px; margin: 0 auto; padding: 48px 32px; position: relative; z-index: 1; }
  .bsq-main { padding-top: 60px; }   /* Basquiat 顶部黑线让出空间 */
  .research-hero { margin-bottom: 48px; max-width: var(--content-max); }
  .research-eyebrow {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .research-title {
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    margin-bottom: 16px;
    font-weight: 500;
  }
  .research-subtitle {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--ink-soft);
  }
  @media (max-width: 640px) { .research-main { padding: 24px 20px; } }
</style>
