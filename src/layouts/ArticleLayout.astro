---
// src/layouts/ArticleLayout.astro
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Header from '@components/chrome/Header.astro';
import Footer from '@components/chrome/Footer.astro';
import BasquiatBackground from '@components/themes/basquiat/BasquiatBackground.astro';
import Crown from '@components/themes/basquiat/Crown.astro';
import ReadingControls from '@components/core/ReadingControls.svelte';
import type { ThemeId } from '@themes';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  researchTitle: string;
  researchHref: string;
  date: Date;
  type: string;
  tags?: string[];
  /** 期次序号 · 在 eyebrow 显示为「第 N 期」 */
  order?: number;
  /** 文章封面图 · Astro 自动 WebP + 多倍图 */
  coverImage?: ImageMetadata;
  theme: ThemeId;
  description?: string;
  ogImage?: string;
}
const { title, researchTitle, researchHref, date, type, tags = [], order, coverImage, theme, description, ogImage } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
const isBasquiat = theme === 'basquiat';
---
<BaseLayout {title} {description} {theme} {ogImage} ogType="article">
  {isBasquiat && <BasquiatBackground />}
  <Header activeNav="research" />
  <article class="article-main" class:list={{ 'bsq-article': isBasquiat }}>
    <header class="article-hero" class:list={{ 'bsq-article-hero': isBasquiat }}>
      {isBasquiat && order && (
        <div class="bsq-issue-stamp">
          <Crown size={28} />
          <span class="bsq-issue-num">第 {order} 期</span>
        </div>
      )}
      <p class="article-eyebrow">
        <a href={researchHref}>{researchTitle}</a>
        {!isBasquiat && order && <> · 第 {order} 期</>}
        · {type}
      </p>
      <h1 class="article-title">{title}</h1>
      {isBasquiat && (
        <svg class="bsq-article-underline" viewBox="0 0 300 10" preserveAspectRatio="none">
          <path d="M 4 5 Q 50 2, 100 6 T 200 7 T 296 5"
                fill="none" stroke="#0a0a0a" stroke-width="3" stroke-linecap="round"/>
        </svg>
      )}
      <p class="article-date">{dateStr}</p>
      {tags.length > 0 && (
        <div class="article-tags">
          {tags.map(t => <span class="tag">#{t}</span>)}
        </div>
      )}
    </header>

    {coverImage && (
      <figure class={`article-cover ${isBasquiat ? 'bsq-cover' : ''}`}>
        <Image
          src={coverImage}
          alt={title}
          widths={[640, 960, 1280]}
          sizes="(max-width: 760px) 100vw, 760px"
          loading="eager"
          decoding="async"
          format="webp"
        />
      </figure>
    )}

    <div class="article-body prose">
      <slot />
    </div>
  </article>
  <Footer />
  <ReadingControls client:idle />
</BaseLayout>
<style>
  .article-main { max-width: var(--content-max); margin: 0 auto; padding: 48px 32px; position: relative; z-index: 1; }
  .bsq-article { padding-top: 60px; }   /* Basquiat 顶部线让位 */
  .article-hero { margin-bottom: 32px; }
  .bsq-article-hero { position: relative; }
  .bsq-issue-stamp {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding: 6px 14px 6px 8px;
    background: #f8d12b;
    border: 3px solid var(--ink);
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .bsq-issue-num {
    font-family: 'Permanent Marker', cursive;
    font-size: 16px;
    letter-spacing: 0.1em;
    color: var(--ink);
    line-height: 1;
  }
  .article-eyebrow {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .article-eyebrow a { border-bottom: none; }
  .article-title {
    font-size: clamp(28px, 4.5vw, 40px);
    line-height: 1.1;
    margin-bottom: 12px;
    font-weight: 500;
  }
  .bsq-article-hero .article-title {
    font-weight: 400;
    padding-left: 10px;
    border-left: 5px solid var(--accent);
  }
  .bsq-article-underline {
    display: block;
    width: 50%;
    height: 10px;
    margin: 4px 0 16px 10px;
  }
  .article-date {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }
  .article-tags { margin-top: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
  .tag {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    padding: 2px 8px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }
  .bsq-article-hero .tag {
    background: var(--bg-soft);
    border: 2px solid var(--ink);
    color: var(--ink);
    font-family: 'Permanent Marker', cursive;
    letter-spacing: 0.08em;
  }
  .article-body { font-size: 17px; line-height: 1.85; }

  /* 封面图 · 通用 */
  .article-cover {
    margin: 32px 0 28px 0;
    width: 100%;
  }
  .article-cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  /* Basquiat 主题封面 · 厚黑边 + 偏移阴影（贴纸风） */
  .bsq-cover {
    border: 3.5px solid var(--ink);
    box-shadow: 8px 8px 0 0 var(--ink);
    background: var(--bg);
  }

  @media (max-width: 640px) {
    .article-main { padding: 24px 20px; }
    .article-body { font-size: 16px; }
    .article-cover { margin: 24px 0 20px 0; }
    .bsq-cover { box-shadow: 5px 5px 0 0 var(--ink); border-width: 3px; }
  }
</style>
