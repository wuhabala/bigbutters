---
// src/layouts/HeckelListPage.astro
// Heckel 木刻风格列表页布局——/topics/ 和 /research/ 共用。
import BaseLayout from './BaseLayout.astro';
import Header from '@components/chrome/Header.astro';
import Footer from '@components/chrome/Footer.astro';
import CoverCard from '@components/chrome/CoverCard.astro';
import HeckelBackground from '@components/themes/heckel/HeckelBackground.astro';
import HeckelSectionTitle from '@components/themes/heckel/HeckelSectionTitle.astro';
import HeckelMark from '@components/themes/heckel/HeckelMark.astro';
import ScrollReveal from '@components/themes/heckel/ScrollReveal.svelte';
import type { ThemeId } from '@themes';
import type { ImageMetadata } from 'astro';

export interface ListItem {
  href: string;
  title: string;
  subtitle?: string;
  summary: string;
  meta: string;
  theme: ThemeId;
  coverImage?: ImageMetadata | string;
}

export interface Props {
  /** Header 高亮的导航项 */
  activeNav: 'topics' | 'research';
  /** 浏览器标题 + page title */
  pageTitle: string;
  /** Section title 英文 eyebrow */
  eyebrow: string;
  /** Section title 中文主标题 */
  zhTitle: string;
  /** 装饰图记 variant */
  mark: 'mountain' | 'sun' | 'face' | 'tree' | 'bird';
  /** Section title 计数文字 */
  count: string;
  /** description meta */
  description?: string;
  /** 网格列数 · 桌面 */
  cols?: 3 | 4;
  /** 卡片数据 */
  items: ListItem[];
  /** 空态文案 */
  emptyText?: string;
}

const {
  activeNav,
  pageTitle,
  eyebrow,
  zhTitle,
  mark,
  count,
  description,
  cols = 4,
  items,
  emptyText = '还没有发布的内容。',
} = Astro.props;
---
<BaseLayout title={pageTitle} description={description} bodyClass="home-heckel">
  <HeckelBackground />
  <Header activeNav={activeNav} />

  <main class="hk-list-main" data-cols={cols}>
    {/* 顶部 hero 带 */}
    <section class="hk-list-hero">
      <div class="hk-list-hero-inner">
        <div class="hk-list-hero-text">
          <p class="hk-list-eyebrow">
            <span class="hk-list-rule"></span>
            {eyebrow}
          </p>
          <h1 class="hk-list-title">
            <span class="hk-list-title-shadow" aria-hidden="true">{zhTitle}</span>
            <span class="hk-list-title-main">{zhTitle}</span>
          </h1>
          <p class="hk-list-count">{count}</p>
        </div>
        <div class="hk-list-hero-mark">
          <HeckelMark variant={mark} size={120}/>
        </div>
      </div>
      <svg class="hk-list-hero-cut" viewBox="0 0 800 18" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="0,0 20,18 40,0 60,18 80,0 100,18 120,0 140,18 160,0 180,18 200,0 220,18 240,0 260,18 280,0 300,18 320,0 340,18 360,0 380,18 400,0 420,18 440,0 460,18 480,0 500,18 520,0 540,18 560,0 580,18 600,0 620,18 640,0 660,18 680,0 700,18 720,0 740,18 760,0 780,18 800,0 800,18 0,18" fill="#0f0a06"/>
      </svg>
    </section>

    {/* 网格 */}
    <section class="hk-list-body">
      <div class="hk-list-body-inner">
        <ScrollReveal client:idle>
          <HeckelSectionTitle eyebrow={eyebrow} title={zhTitle} count={count} mark={mark}/>
        </ScrollReveal>

        {items.length === 0 ? (
          <p class="hk-list-empty">{emptyText}</p>
        ) : (
          <div class="hk-list-grid">
            {items.map((it, i) => (
              <ScrollReveal client:idle delay={40 + i * 25}>
                <article class="hk-list-card" style={`--card-i:${i}`}>
                  <a href={it.href} class="hk-list-card-cover">
                    <CoverCard
                      href={it.href}
                      title={it.title}
                      theme={it.theme}
                      meta={it.meta}
                      coverImage={it.coverImage}
                      aspectRatio="3 / 4"
                    />
                  </a>
                  <div class="hk-list-card-meta">
                    <span class="hk-list-card-num">{String(i + 1).padStart(2, '0')}</span>
                    <div class="hk-list-card-text">
                      <h3 class="hk-list-card-title">{it.title}</h3>
                      {it.subtitle && <p class="hk-list-card-sub">{it.subtitle}</p>}
                      <p class="hk-list-card-summary">{it.summary}</p>
                      <p class="hk-list-card-status">{it.meta}</p>
                    </div>
                  </div>
                </article>
              </ScrollReveal>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .hk-list-main { position: relative; z-index: 1; }

  /* ===== Hero 带 ===== */
  .hk-list-hero {
    background: #f4ead0;
    border-bottom: none;
    overflow: hidden;
  }
  .hk-list-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 32px 64px;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 36px;
    align-items: center;
  }
  .hk-list-hero-text { min-width: 0; }
  .hk-list-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #d92410;
    margin-bottom: 18px;
  }
  .hk-list-rule {
    display: inline-block;
    width: 36px;
    height: 3px;
    background: #d92410;
  }
  .hk-list-title {
    position: relative;
    margin: 0 0 12px;
    line-height: 0.95;
    font-family: 'Noto Serif SC', 'Songti SC', serif;
    font-weight: 900;
    font-size: clamp(56px, 8vw, 108px);
    letter-spacing: 0.02em;
    color: #0f0a06;
  }
  .hk-list-title-shadow {
    position: absolute;
    top: 6px;
    left: 8px;
    color: #d92410;
    z-index: 0;
    user-select: none;
  }
  .hk-list-title-main {
    position: relative;
    z-index: 1;
  }
  .hk-list-count {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 16px;
    color: #3a2e22;
    letter-spacing: 0.05em;
  }
  .hk-list-hero-mark {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .hk-list-hero-cut {
    display: block;
    width: 100%;
    height: 18px;
    margin-top: 0;
  }

  /* ===== Body / Grid ===== */
  .hk-list-body {
    background: rgba(35, 78, 125, 0.06);  /* 与首页 hk-topics-wrap 一致 */
    padding: 56px 0 80px;
  }
  .hk-list-body-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .hk-list-empty {
    font-family: 'EB Garamond', 'Noto Serif SC', serif;
    font-style: italic;
    color: #3a2e22;
    margin-top: 32px;
  }

  /* 4 列网格 */
  .hk-list-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), 1fr);
    gap: 32px;
    margin-top: 24px;
  }
  .hk-list-main[data-cols="3"] .hk-list-grid { --cols: 3; gap: 36px; }
  .hk-list-main[data-cols="4"] .hk-list-grid { --cols: 4; }

  /* 卡 */
  .hk-list-card {
    display: flex;
    flex-direction: column;
  }
  .hk-list-card-cover {
    display: block;
    border: 3.5px solid #0f0a06;
    box-shadow: 7px 7px 0 0 #1c4a8a;
    transition: transform 200ms ease, box-shadow 200ms ease;
    background: #f4ead0;
  }
  .hk-list-card-cover :global(.cover-card) {
    border: none;
    box-shadow: none;
  }
  /* 三色循环阴影——和首页 .hk-topic-card 保持视觉 rhythm */
  .hk-list-card:nth-child(3n+1) .hk-list-card-cover { box-shadow: 7px 7px 0 0 #d92410; }
  .hk-list-card:nth-child(3n+2) .hk-list-card-cover { box-shadow: 7px 7px 0 0 #1c4a8a; }
  .hk-list-card:nth-child(3n)   .hk-list-card-cover { box-shadow: 7px 7px 0 0 #f5b800; }
  .hk-list-card-cover:hover {
    transform: translate(-3px, -3px);
    box-shadow: 10px 10px 0 0 #0f0a06 !important;
  }

  .hk-list-card-meta {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    padding: 16px 0 0;
    align-items: start;
  }
  .hk-list-card-num {
    font-family: 'EB Garamond', serif;
    font-size: 26px;
    font-weight: 700;
    color: #d92410;
    line-height: 1;
  }
  .hk-list-card-title {
    font-family: 'Noto Serif SC', serif;
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 4px;
    color: #0f0a06;
    line-height: 1.3;
  }
  .hk-list-card-sub {
    font-family: 'EB Garamond', 'Noto Serif SC', serif;
    font-style: italic;
    font-size: 12px;
    color: #3a2e22;
    margin: 0 0 6px;
  }
  .hk-list-card-summary {
    font-size: 13px;
    line-height: 1.6;
    color: #0f0a06;
    margin: 0 0 8px;
  }
  .hk-list-card-status {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #1c4a8a;
    margin: 0;
    padding-top: 4px;
    border-top: 1.5px solid rgba(15, 10, 6, 0.18);
  }

  /* ===== 响应式 ===== */
  @media (max-width: 1080px) {
    .hk-list-main[data-cols="4"] .hk-list-grid { --cols: 3; }
  }
  @media (max-width: 820px) {
    .hk-list-hero-inner {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 40px 24px 50px;
    }
    .hk-list-hero-mark { justify-content: flex-start; }
    .hk-list-body { padding: 40px 0 60px; }
    .hk-list-body-inner { padding: 0 24px; }
    .hk-list-main[data-cols] .hk-list-grid { --cols: 2; gap: 22px; }
  }
  @media (max-width: 520px) {
    .hk-list-main[data-cols] .hk-list-grid { --cols: 1; gap: 32px; }
    .hk-list-title { font-size: clamp(44px, 12vw, 64px); }
    .hk-list-card-cover { box-shadow: 5px 5px 0 0 #1c4a8a !important; }
    .hk-list-card:nth-child(3n+1) .hk-list-card-cover { box-shadow: 5px 5px 0 0 #d92410 !important; }
    .hk-list-card:nth-child(3n+2) .hk-list-card-cover { box-shadow: 5px 5px 0 0 #1c4a8a !important; }
    .hk-list-card:nth-child(3n)   .hk-list-card-cover { box-shadow: 5px 5px 0 0 #f5b800 !important; }
  }
</style>
