---
// src/layouts/IssueLayout.astro
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Header from '@components/chrome/Header.astro';
import Footer from '@components/chrome/Footer.astro';
import RomanChapter from '@components/themes/schiele/RomanChapter.astro';
import EscherBackground from '@components/themes/escher/EscherBackground.astro';
import ImpossibleSteps from '@components/themes/escher/ImpossibleSteps.astro';
import type { ThemeId } from '@themes';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  issueNum: number;
  chapter?: string;
  topicTitle: string;
  topicHref: string;
  date: Date;
  theme: ThemeId;
  description?: string;
  ogImage?: string;
  heroImage?: ImageMetadata;
}
const { title, issueNum, chapter, topicTitle, topicHref, date, theme, description, ogImage, heroImage } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
const isEscher = theme === 'escher';
---
<BaseLayout {title} {description} {theme} {ogImage} ogType="article">
  {isEscher && <EscherBackground />}
  <Header activeNav="topics" />
  <article class="issue-main" class:list={{ 'esch-issue-main': isEscher }}>
    <header class="issue-hero" class:list={{ 'esch-issue-hero': isEscher }}>
      {isEscher && (
        <div class="esch-chapter-mark">
          <ImpossibleSteps size={66} />
          <span>{chapter ?? `第 ${issueNum} 期`}</span>
        </div>
      )}
      <p class="issue-eyebrow"><a href={topicHref}>{topicTitle}</a> · {chapter ?? `第 ${issueNum} 期`}</p>
      {theme === 'schiele' && <RomanChapter num={issueNum} />}
      <h1 class="issue-title">{title}</h1>
      <p class="issue-date">{dateStr}</p>
    </header>
    {heroImage && (
      <figure class="issue-cover" class:list={{ 'esch-cover': isEscher }}>
        <Image
          src={heroImage}
          alt={title}
          widths={[640, 960, 1280]}
          sizes="(max-width: 760px) 100vw, 760px"
          loading="eager"
          decoding="async"
          format="webp"
        />
      </figure>
    )}
    <div class="issue-body prose">
      <slot />
    </div>
  </article>
  <Footer />
</BaseLayout>
<style>
  .issue-main {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 48px 32px;
  }
  .esch-issue-main { position: relative; z-index: 1; padding-top: 52px; }
  .issue-hero { margin-bottom: 40px; }
  .esch-issue-hero {
    position: relative;
    padding: 0 0 22px 28px;
    border-left: 1px solid rgba(68, 141, 139, 0.42);
  }
  .esch-issue-hero::before {
    content: '';
    position: absolute;
    left: -1px;
    bottom: 0;
    width: clamp(110px, 25vw, 196px);
    height: 1px;
    background: var(--ochre);
  }
  .esch-issue-hero::after {
    content: '';
    position: absolute;
    left: clamp(110px, 25vw, 196px);
    bottom: -5px;
    width: 11px;
    height: 11px;
    background: var(--accent);
  }
  .esch-chapter-mark {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--ochre);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.32em;
    margin-bottom: 18px;
  }
  .issue-eyebrow {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .issue-eyebrow a { border-bottom: none; }
  .issue-title {
    font-size: clamp(29px, 4.1vw, 40px);
    line-height: 1.15;
    margin-bottom: 16px;
    font-weight: 300;
  }
  .issue-date {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }
  .issue-body { font-size: 17px; line-height: 1.85; }
  .issue-cover { margin: 0 0 38px; }
  .issue-cover img { width: 100%; height: auto; display: block; }
  .esch-cover { position: relative; border: 1px solid var(--rule); padding: 12px; background: var(--bg-soft); box-shadow: 14px 14px 0 rgba(201,188,169,0.24); }
  .esch-cover::before {
    content: '';
    position: absolute;
    top: -9px;
    right: 30px;
    width: 74px;
    height: 9px;
    background: linear-gradient(90deg, var(--ochre) 0 56%, var(--accent) 56%);
  }
  .esch-cover::after {
    content: '';
    position: absolute;
    left: -20px;
    bottom: 42px;
    width: 20px;
    height: 96px;
    border: 1px solid var(--ochre);
    border-right: 0;
  }
  @media (max-width: 640px) {
    .issue-main { padding: 24px 20px; }
    .issue-body { font-size: 16px; line-height: 1.75; }
    .esch-issue-hero { padding-left: 18px; }
    .esch-cover::after { display: none; }
  }
</style>
