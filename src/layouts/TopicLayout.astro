---
// src/layouts/TopicLayout.astro
import BaseLayout from './BaseLayout.astro';
import Header from '@components/chrome/Header.astro';
import Footer from '@components/chrome/Footer.astro';
import EscherBackground from '@components/themes/escher/EscherBackground.astro';
import EscherHero from '@components/themes/escher/EscherHero.astro';
import type { ThemeId } from '@themes';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
  theme: ThemeId;
  description?: string;
  ogImage?: string;
  heroImage?: ImageMetadata;
}
const { title, subtitle, theme, description, ogImage, heroImage } = Astro.props;
const isEscher = theme === 'escher';
---
<BaseLayout {title} {description} {theme} {ogImage}>
  {isEscher && <EscherBackground />}
  <Header activeNav="topics" />
  <main class="topic-main" class:list={{ 'esch-topic-main': isEscher }}>
    {isEscher ? (
      <EscherHero {title} {subtitle} {heroImage} />
    ) : (
      <header class="topic-hero">
        <p class="topic-eyebrow">专题</p>
        <h1 class="topic-title">{title}</h1>
        {subtitle && <p class="topic-subtitle">{subtitle}</p>}
      </header>
    )}
    <slot />
  </main>
  <Footer />
</BaseLayout>
<style>
  .topic-main { max-width: 1100px; margin: 0 auto; padding: 48px 32px; }
  .esch-topic-main { position: relative; z-index: 1; padding-top: 56px; }
  .topic-hero { margin-bottom: 48px; max-width: var(--content-max); }
  .topic-eyebrow {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .topic-title {
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    margin-bottom: 16px;
    font-weight: 500;  /* 避免 SemiBold；外部评审反馈 */
  }
  .topic-subtitle {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .topic-main { padding: 24px 20px; }
  }
</style>
