---
import ResearchLayout from '@layouts/ResearchLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map(r => {
    const slug = r.id.split('/')[0];
    return {
      params: { research: slug },
      props: { research: r },
    };
  });
}

const { research } = Astro.props;
const slug = research.id.split('/')[0];

const allArticles = await getCollection('researchArticles');

// 排序：优先按 order 字段升序（用户指定的"第 1 期/第 2 期"序列）；
// order 缺省时回退到按文件名 slug 字典序（自然 01-/02- 也对）；
// 全无 order 时按日期降序（兼容旧数据）。
const articles = allArticles
  .filter(a => a.id.startsWith(slug + '/'))
  .sort((a, b) => {
    const oa = a.data.order;
    const ob = b.data.order;
    if (oa !== undefined && ob !== undefined) return oa - ob;
    if (oa !== undefined) return -1;
    if (ob !== undefined) return 1;
    // 退化：用 slug 字典序（01- 自然在 02- 前）
    return a.id.localeCompare(b.id);
  });

const { Content } = await render(research);
---
<ResearchLayout
  title={research.data.title}
  subtitle={research.data.subtitle}
  theme={research.data.theme}
  description={research.data.summary}
  ogImage={research.data.cover?.hero_image?.src}
  heroImage={research.data.cover?.hero_image}
>
  <div class={`research-summary prose ${research.data.theme === 'basquiat' ? 'bsq-summary' : ''}`}>
    <p>{research.data.summary}</p>
    <Content />
  </div>

  <section class={`articles ${research.data.theme === 'basquiat' ? 'bsq-articles' : ''}`}>
    <h2 class="articles-title">研究文章</h2>
    {articles.length === 0 ? (
      <p class="articles-empty">这个研究暂时还没有发布的文章。</p>
    ) : (
      <ol class="articles-list">
        {articles.map(a => {
          const articleSlug = a.id.split('/').slice(1).join('/').replace(/\.(md|mdx)$/, '');
          const issueLabel = a.data.order ? `第 ${a.data.order} 期` : null;
          return (
            <li class="article-entry">
              <a href={`/research/${slug}/${articleSlug}/`}>
                <span class="a-num">{issueLabel ?? a.data.date.toISOString().slice(0, 10)}</span>
                <span class="a-body">
                  <span class="a-title">{a.data.title}</span>
                  <span class="a-meta">{a.data.type}{a.data.length && ` · ${a.data.length} 字`}</span>
                  {a.data.tags.length > 0 && (
                    <span class="a-tags">{a.data.tags.map(t => `#${t}`).join(' ')}</span>
                  )}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    )}
  </section>
</ResearchLayout>
<style>
  .research-summary { max-width: var(--content-max); font-size: 17px; line-height: 1.85; margin-bottom: 48px; }
  .articles-title {
    font-family: 'EB Garamond', serif; font-size: 12px;
    letter-spacing: 0.4em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 16px;
    border-bottom: 1px solid var(--rule); padding-bottom: 8px;
    font-weight: 400;
  }
  .articles-empty { color: var(--ink-faint); font-style: italic; }
  .articles-list { display: grid; gap: 4px; padding: 0; list-style: none; }
  .article-entry { border-bottom: 1px dotted var(--rule); }
  .article-entry a {
    display: grid; grid-template-columns: 100px 1fr;
    gap: 20px; padding: 14px 0;
    border-bottom: none; color: inherit;
  }
  .a-num {
    font-family: 'EB Garamond', serif;
    font-size: 13px; letter-spacing: 0.15em; color: var(--accent);
    font-weight: 600;
  }

  /* ============ Basquiat 主题专属 · 列表更涂鸦 ============ */
  .bsq-articles .articles-title {
    font-family: 'Permanent Marker', cursive;
    font-size: 16px;
    color: var(--accent);
    border-bottom: 3px solid var(--ink);
    padding-bottom: 6px;
  }
  .bsq-articles .article-entry {
    border-bottom: 2px dashed var(--ink);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .bsq-articles .article-entry:hover {
    background: var(--bg-soft);
    transform: translateX(4px);
  }
  .bsq-articles .a-num {
    font-family: 'Permanent Marker', cursive;
    font-size: 15px;
    color: var(--ink);
    background: #f8d12b;
    padding: 2px 8px;
    border: 2.5px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    align-self: flex-start;
    transform: rotate(-1.5deg);
  }
  .bsq-articles .a-title {
    font-weight: 700;
    color: var(--ink);
  }
  .bsq-articles .a-tags {
    font-family: 'Permanent Marker', cursive;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .a-title { display: block; font-size: 16px; font-weight: 500; margin-bottom: 4px; }
  .a-meta { display: block; font-family: 'EB Garamond', serif; font-style: italic; font-size: 12px; color: var(--ink-soft); margin: 0 0 4px 0; }
  .a-tags { display: block; font-family: 'EB Garamond', serif; font-size: 11px; color: var(--ochre); margin: 0; }
</style>
