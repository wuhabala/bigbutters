---
import HeckelListPage from '@layouts/HeckelListPage.astro';
import type { ListItem } from '@layouts/HeckelListPage.astro';
import { getCollection } from 'astro:content';

const research = await getCollection('research');
const sorted = research.sort((a, b) => b.data.started.localeCompare(a.data.started));
const items: ListItem[] = sorted.map(r => {
  const slug = r.id.split('/')[0];
  return {
    href: `/research/${slug}/`,
    title: r.data.title,
    subtitle: r.data.subtitle,
    summary: r.data.summary,
    meta: r.data.status === 'ongoing' ? '进行中' : '已沉淀',
    theme: r.data.theme,
    coverImage: r.data.cover?.hero_image_portrait ?? r.data.cover?.hero_image,
  };
});
---
<HeckelListPage
  activeNav="research"
  pageTitle="所有研究"
  description="大大黄油的全部研究"
  eyebrow="All Research"
  zhTitle="所有研究"
  mark="tree"
  count={`${sorted.length} 个研究`}
  cols={3}
  items={items}
  emptyText="还没有发布的研究。"
/>
