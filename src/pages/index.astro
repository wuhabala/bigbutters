---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/chrome/Header.astro';
import Footer from '@components/chrome/Footer.astro';
import HeckelHome from '@layouts/HeckelHome.astro';
import type { FeaturedTopic, TopicCardData, ResearchGroup } from '@layouts/HeckelHome.astro';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
// Collection ID 格式（修正后）：
//   topic.id  = '<slug>/index'        → split('/')[0] = slug
//   issue.id  = '<topic-slug>/<issue-slug>'
const topicMap = new Map(topics.map(t => [t.id.split('/')[0], t]));

const allIssues = await getCollection('issues');
const publishedIssues = allIssues.filter(i => i.data.status === 'published');
const latestIssue = [...publishedIssues].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];

// 真空状态独立分支：不存在任何专题时，渲染纯介绍页（评审 #11）
const isEmptyState = topics.length === 0;

let featured: FeaturedTopic | null = null;
if (!isEmptyState) {
  if (latestIssue) {
    const parts = latestIssue.id.split('/');
    const topicSlug = parts[0];
    const issueSlug = parts.slice(1).join('/');
    const featuredTopic = topicMap.get(topicSlug);
    if (featuredTopic) {
      featured = {
        slug: topicSlug,
        title: featuredTopic.data.title,
        theme: featuredTopic.data.theme,
        issueTitle: latestIssue.data.title,
        issueHref: `/topics/${topicSlug}/${issueSlug}/`,
        issueNum: latestIssue.data.issue,
        blurb: latestIssue.data.summary ?? featuredTopic.data.summary,
        // 首页卡片优先竖版（aspect-ratio 4:5），缺省回退横版
        coverImage: featuredTopic.data.cover?.hero_image_portrait ?? featuredTopic.data.cover?.hero_image,
      };
    }
  }
  if (!featured) {
    const fallbackTopic = topics[0];
    const fallbackSlug = fallbackTopic.id.split('/')[0];
    featured = {
      slug: fallbackSlug,
      title: fallbackTopic.data.title,
      theme: fallbackTopic.data.theme,
      issueTitle: fallbackTopic.data.title,
      issueHref: `/topics/${fallbackSlug}/`,
      issueNum: 0,
      blurb: fallbackTopic.data.summary,
      coverImage: fallbackTopic.data.cover?.hero_image_portrait ?? fallbackTopic.data.cover?.hero_image,
    };
  }
}

const allTopics: TopicCardData[] = topics
  .sort((a, b) => b.data.started.localeCompare(a.data.started))
  .map(t => {
    const slug = t.id.split('/')[0];
    const numIssues = publishedIssues.filter(i => i.id.startsWith(slug + '/')).length;
    let meta = '';
    if (t.data.status === 'ongoing') {
      meta = t.data.type === 'series'
        ? `${numIssues} / ${t.data.planned_issues ?? '?'} 期 · 进行中`
        : '进行中';
    } else if (t.data.status === 'planning') {
      meta = t.data.type === 'series' ? '筹备 · 多期' : '筹备 · 单期';
    } else {
      meta = '已完结';
    }
    return {
      slug,
      title: t.data.title,
      theme: t.data.theme,
      meta,
      // 首页横向轮播也用竖版优先
      coverImage: t.data.cover?.hero_image_portrait ?? t.data.cover?.hero_image,
    };
  });

// 研究 · 按研究专题分组，每组带最新 3 篇
const allArticles = await getCollection('researchArticles');
const researchAll = await getCollection('research');
const researchOrder: Record<string, number> = {
  'ai-safety-boundary': 1,
  'aix-literature': 2,
  'aix-education-family-guide': 3,
  'foucault-studies': 4,
  'ai-ethics-research': 5,
};
const getResearchRank = (slug: string) => researchOrder[slug] ?? 99;

const researchGroups: ResearchGroup[] = researchAll
  .map(r => {
    const slug = r.id.split('/')[0];
    const articles = allArticles
      .filter(a => a.id.startsWith(slug + '/'))
      .sort((a, b) => {
        // 优先用 order（与文件名 01/02 对齐），其次 date 倒序
        if (a.data.order != null && b.data.order != null) return a.data.order - b.data.order;
        return b.data.date.getTime() - a.data.date.getTime();
      });
    const latest = articles.slice(0, 3).map(a => {
      const parts = a.id.split('/');
      return {
        href: `/research/${parts[0]}/${parts.slice(1).join('/')}/`,
        title: a.data.title,
        date: a.data.date,
        type: a.data.type,
        order: a.data.order,
      };
    });
    return {
      slug,
      title: r.data.title,
      subtitle: r.data.subtitle,
      summary: r.data.summary,
      href: `/research/${slug}/`,
      status: r.data.status,
      started: r.data.started,
      // 首页研究区卡片竖版优先
      coverImage: r.data.cover?.hero_image_portrait ?? r.data.cover?.hero_image,
      totalArticles: articles.length,
      latestArticles: latest,
    } satisfies ResearchGroup;
  })
  .filter(g => g.latestArticles.length > 0)
  // 手动策展顺序优先；未指定的研究回退到进行中优先 + started 降序
  .sort((a, b) => {
    const rankDiff = getResearchRank(a.slug) - getResearchRank(b.slug);
    if (rankDiff !== 0) return rankDiff;
    if (a.status !== b.status) return a.status === 'ongoing' ? -1 : 1;
    return b.started.localeCompare(a.started);
  });
---
{isEmptyState ? (
  <BaseLayout title="大大黄油" description="个人交互式学术策展空间">
    <Header activeNav={null} />
    <main class="empty-home">
      <p class="empty-eyebrow">🪳 bigbutters · 外壳搭建完成 · 内容筹备中</p>
      <h1 class="empty-title">大大黄油</h1>
      <p class="empty-claim">
        个人交互式学术策展空间——<br />
        承载福柯、AIX 教育、AI 边界伦理、内卷文化、通向实在之路等方向的研究。
      </p>
      <p class="empty-detail">
        每个专题挂载一位艺术家的视觉系统，同一个站点呈现完全不同的"展厅"。<br />
        首批内容即将上线。
      </p>
      <div class="empty-cta">
        <a href="/about/">↪ 关于大大黄油</a>
      </div>
    </main>
    <Footer />
  </BaseLayout>
) : (
  <HeckelHome
    featured={featured!}
    allTopics={allTopics}
    researchGroups={researchGroups}
  />
)}

<style>
  .empty-home {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 96px 32px;
  }
  .empty-eyebrow {
    font-family: 'EB Garamond', serif;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 24px;
  }
  .empty-title {
    font-size: clamp(56px, 9vw, 96px);
    line-height: 1;
    font-weight: 500;
    margin-bottom: 32px;
    letter-spacing: -0.01em;
  }
  .empty-claim {
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .empty-detail {
    font-family: 'EB Garamond', serif;
    font-style: italic;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 32px;
  }
  .empty-cta a {
    font-family: 'EB Garamond', serif;
    font-size: 12px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }
  @media (max-width: 640px) {
    .empty-home { padding: 48px 24px; }
  }
</style>
