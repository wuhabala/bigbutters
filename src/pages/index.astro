---
import HomeLayout from '@layouts/HomeLayout.astro';
import type { FeaturedTopic, TopicCardData, ResearchEntry } from '@layouts/HomeLayout.astro';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const topicMap = new Map(topics.map(t => [t.id.split('/')[0], t]));

const allIssues = await getCollection('issues');
const publishedIssues = allIssues.filter(i => i.data.status === 'published');
const latestIssue = [...publishedIssues].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];

let featured: FeaturedTopic;
if (latestIssue && topics.length > 0) {
  const parts = latestIssue.id.split('/');
  const topicSlug = parts[0];
  const issueSlug = parts.slice(1).join('/').replace(/\.(md|mdx)$/, '');
  const featuredTopic = topicMap.get(topicSlug)!;
  featured = {
    slug: topicSlug,
    title: featuredTopic.data.title,
    theme: featuredTopic.data.theme,
    issueTitle: latestIssue.data.title,
    issueHref: `/topics/${topicSlug}/${issueSlug}/`,
    issueNum: latestIssue.data.issue,
    blurb: latestIssue.data.summary ?? featuredTopic.data.summary,
    coverImage: featuredTopic.data.cover?.hero_image?.src,
  };
} else if (topics.length > 0) {
  // fallback：无已发布期时用第一个专题
  const fallbackTopic = topics[0]!;
  const fallbackSlug = fallbackTopic.id.split('/')[0];
  featured = {
    slug: fallbackSlug,
    title: fallbackTopic.data.title,
    theme: fallbackTopic.data.theme,
    issueTitle: fallbackTopic.data.title,
    issueHref: `/topics/${fallbackSlug}/`,
    issueNum: 0,
    blurb: fallbackTopic.data.summary,
    coverImage: fallbackTopic.data.cover?.hero_image?.src,
  };
} else {
  // 极端 fallback：完全没有内容时
  featured = {
    slug: '',
    title: '大大黄油',
    theme: 'schiele',
    issueTitle: '外壳搭建中',
    issueHref: '/about/',
    issueNum: 0,
    blurb: '内容正在准备。',
  };
}

const allTopics: TopicCardData[] = topics
  .sort((a, b) => b.data.started.localeCompare(a.data.started))
  .map(t => {
    const slug = t.id.split('/')[0];
    const numIssues = publishedIssues.filter(i => i.id.startsWith(slug + '/')).length;
    let meta = '';
    if (t.data.status === 'ongoing') {
      meta = t.data.type === 'series'
        ? `${numIssues} / ${t.data.planned_issues ?? '?'} 期 · 进行中`
        : '进行中';
    } else if (t.data.status === 'planning') {
      meta = t.data.type === 'series' ? '筹备 · 多期' : '筹备 · 单期';
    } else {
      meta = '已完结';
    }
    return {
      slug,
      title: t.data.title,
      theme: t.data.theme,
      meta,
      coverImage: t.data.cover?.hero_image?.src,
    };
  });

const allArticles = await getCollection('researchArticles');
const researchAll = await getCollection('research');
const researchMap = new Map(researchAll.map(r => [r.id.split('/')[0], r]));

const recentResearch: ResearchEntry[] = [...allArticles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6)
  .map(a => {
    const parts = a.id.split('/');
    const researchSlug = parts[0];
    const articleSlug = parts.slice(1).join('/').replace(/\.(md|mdx)$/, '');
    const r = researchMap.get(researchSlug);
    return {
      href: `/research/${researchSlug}/${articleSlug}/`,
      title: a.data.title,
      date: a.data.date,
      type: a.data.type,
      length: a.data.length,
      researchTitle: r?.data.title ?? researchSlug,
      researchSlug,
    };
  });

const tagSet = new Set<string>();
allArticles.forEach(a => a.data.tags.forEach(t => tagSet.add(t)));
const researchTags = Array.from(tagSet).slice(0, 8);
---
<HomeLayout
  featured={featured}
  allTopics={allTopics}
  recentResearch={recentResearch}
  researchTags={researchTags}
/>
