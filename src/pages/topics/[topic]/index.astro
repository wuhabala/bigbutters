---
import TopicLayout from '@layouts/TopicLayout.astro';
import InvCultureTopic from '@components/topics/InvCultureTopic.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map(t => {
    const slug = t.id.split('/')[0];
    return {
      params: { topic: slug },
      props: { topic: t },
    };
  });
}

const { topic } = Astro.props;
const slug = topic.id.split('/')[0];
const isInvCulture = slug === 'inv-culture';

// 该专题的所有 published 期（过滤 draft）
const allIssues = await getCollection('issues');
const issues = allIssues
  .filter(i => i.id.startsWith(slug + '/'))
  .filter(i => i.data.status === 'published')
  .sort((a, b) => a.data.issue - b.data.issue);

let Content;
if (!isInvCulture) {
  ({ Content } = await render(topic));
}
---
{isInvCulture ? (
  <InvCultureTopic topic={topic} />
) : (
  <TopicLayout
    title={topic.data.title}
    subtitle={topic.data.subtitle}
    theme={topic.data.theme}
    description={topic.data.summary}
    ogImage={topic.data.cover?.hero_image?.src}
    heroImage={topic.data.cover?.hero_image}
  >
    <div class={`topic-summary prose ${topic.data.theme === 'basquiat' ? 'bsq-summary' : ''}`}>
      <p>{topic.data.summary}</p>
      {Content && <Content />}
    </div>

    <section class={`issues ${topic.data.theme === 'basquiat' ? 'bsq-issues' : ''}`}>
      <h2 class="issues-title">期目录</h2>
      {issues.length === 0 ? (
        <p class="issues-empty">这个专题暂时还没有发布的期。</p>
      ) : (
        <ol class="issues-list">
          {issues.map(i => {
            const issueSlug = i.id.split('/').slice(1).join('/').replace(/\.(md|mdx)$/, '');
            return (
              <li class="issue-entry">
                <a href={`/topics/${slug}/${issueSlug}/`}>
                    <span class="i-num">{i.data.chapter ?? String(i.data.issue).padStart(2, '0')}</span>
                  <span class="i-body">
                    <span class="i-title">{i.data.title}</span>
                    {i.data.summary && <span class="i-summary">{i.data.summary}</span>}
                  </span>
                  <span class="i-date">
                    {i.data.date.toISOString().slice(0, 10)}
                  </span>
                </a>
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </TopicLayout>
)}
<style>
  .topic-summary { max-width: var(--content-max); font-size: 17px; line-height: 1.85; margin-bottom: 48px; }
  .issues-title {
    font-family: 'EB Garamond', serif; font-size: 12px;
    letter-spacing: 0.4em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 16px;
    border-bottom: 1px solid var(--rule); padding-bottom: 8px;
    font-weight: 400;
  }
  .issues-empty { color: var(--ink-faint); font-style: italic; }
  .issues-list { display: grid; gap: 4px; padding: 0; list-style: none; }
  .issue-entry { border-bottom: 1px dotted var(--rule); }
  .issue-entry a {
    display: grid; grid-template-columns: 60px 1fr auto;
    gap: 20px; padding: 14px 0;
    border-bottom: none; color: inherit;
  }
  .i-num {
    font-family: 'EB Garamond', serif;
    font-size: 24px; color: var(--ochre);
  }
  .i-title { display: block; font-size: 17px; font-weight: 500; margin-bottom: 4px; }
  .i-summary { display: block; font-size: 13px; color: var(--ink-soft); line-height: 1.6; }
  .i-date { font-family: 'EB Garamond', serif; font-style: italic; font-size: 12px; color: var(--ink-faint); }
  .bsq-issues .issues-title {
    font-family: 'Permanent Marker', cursive;
    font-size: 16px;
    color: var(--accent);
    border-bottom: 3px solid var(--ink);
    padding-bottom: 6px;
  }
  .bsq-issues .issue-entry {
    border-bottom: 2px dashed var(--ink);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .bsq-issues .issue-entry:hover {
    background: var(--bg-soft);
    transform: translateX(4px);
  }
  .bsq-issues .i-num {
    font-family: 'Permanent Marker', cursive;
    font-size: 15px;
    color: var(--ink);
    background: var(--bg);
    padding: 2px 8px;
    border: 2px solid var(--ink);
    align-self: flex-start;
    transform: rotate(-1.5deg);
  }
  .bsq-issues .i-title {
    font-weight: 700;
    color: var(--ink);
  }
  .bsq-issues .i-summary {
    color: var(--ink-soft);
  }
</style>
