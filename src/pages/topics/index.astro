---
import HeckelListPage from '@layouts/HeckelListPage.astro';
import type { ListItem } from '@layouts/HeckelListPage.astro';
import { getCollection } from 'astro:content';

const topics = await getCollection('topics');
const sorted = topics.sort((a, b) => b.data.started.localeCompare(a.data.started));
const items: ListItem[] = sorted.map(t => {
  const slug = t.id.split('/')[0];
  const meta =
    t.data.status === 'ongoing'
      ? '进行中'
      : t.data.status === 'planning'
      ? '筹备'
      : '已完结';
  return {
    href: `/topics/${slug}/`,
    title: t.data.title,
    subtitle: t.data.subtitle,
    summary: t.data.summary,
    meta,
    theme: t.data.theme,
    coverImage: t.data.cover?.hero_image_portrait ?? t.data.cover?.hero_image,
  };
});
---
<HeckelListPage
  activeNav="topics"
  pageTitle="所有专题"
  description="大大黄油的全部专题"
  eyebrow="All Topics"
  zhTitle="所有专题"
  mark="mountain"
  count={`${sorted.length} 个专题`}
  cols={4}
  items={items}
  emptyText="还没有发布的专题。"
/>
